diff --git a/window_attention.py b/window_attention.py
new file mode 100644
--- /dev/null
+++ b/window_attention.py
@@ -0,0 +1,22 @@
+"""Sliding-window bookkeeping for the single-GPU inference experiment.
+
+Windows count visible positions INCLUDING the current token. Interval 4 means
+local, local, local, global; 0 means all local and 1 means all global.
+"""
+
+
+def layer_mask(num_layers, window, interval):
+    if window is None:
+        return [False] * num_layers
+    return [interval == 0 or (index + 1) % interval != 0 for index in range(num_layers)]
+
+
+def retained_by_layer(tokens, num_layers, window, interval):
+    return [min(tokens, window) if local else tokens
+            for local in layer_mask(num_layers, window, interval)]
+
+
+def sum_capped_positions(first, count, cap):
+    """Sum min(first + step, cap) over count consecutive decode steps."""
+    growing = max(0, min(count, cap - first + 1))
+    return growing * (2 * first + growing - 1) // 2 + (count - growing) * cap
